# RentFlow Backend — Environment Variables
# Copy this file to .env and fill in real values.

# ======================
# Server
# ======================
PORT=4000
NODE_ENV=development

# ======================
# JWT Authentication (fill these in for Commit 3)
# ======================
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=24h

# ======================
# Database (fill these in for Commit 2)
# ======================
DATABASE_URL="file:./data/rentflow.db"

# ======================
# CORS — Frontend origin
# ======================
CORS_ORIGIN=http://localhost:5173

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
