# Copy this file to .env and fill in real values.
# Google OAuth: create credentials at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook Login: create an app at https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Base URL of your backend API (for real auth/token verification, orders, etc.)
VITE_API_BASE_URL=http://localhost:4000/api
